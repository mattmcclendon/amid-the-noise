---
interface StudyLink {
  label: string;
  href: string;
}

interface Props {
  links?: StudyLink[];
}

const { links = [] } = Astro.props;
---

{links.length > 0 && (
  <nav class="study-links" aria-label="Related studies">
    {links.map((link) => (
      <a href={link.href}>{link.label} →</a>
    ))}
  </nav>
)}

<style>
  .study-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 1rem;
    font-size: 0.96rem;
    font-weight: 400;
    line-height: 1.6;
  }

  .study-links a {
    color: inherit;
    text-decoration: none;
  }

  .study-links a:hover,
  .study-links a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.14em;
    text-decoration-thickness: 1px;
  }
</style>